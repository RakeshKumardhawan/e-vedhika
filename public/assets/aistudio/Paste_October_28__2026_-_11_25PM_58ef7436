                  <th className="py-3 px-4">చివరిసారి చూసినది (Last Seen)</th>
                  <th className="py-3 px-4">వెర్షన్ (Version)</th>
                  <th className="py-3 px-4 text-right">స్థితి (Status)</th>
                </tr>
              )}
              {activeBox === 'hardware' && (
                <tr>
                  <th className="py-3 px-4">PC పేరు</th>
                  <th className="py-3 px-4">CPU & RAM</th>
                  <th className="py-3 px-4">డిస్క్ స్పేస్ (Disk)</th>
                  <th className="py-3 px-4">OS వెర్షన్</th>
                  <th className="py-3 px-4 text-right">IP అడ్రస్</th>
                </tr>
              )}
              {activeBox === 'policies' && (
                <tr>
                  <th className="py-3 px-4">PC పేరు</th>
                  <th className="py-3 px-4">Edge IE Mode</th>
                  <th className="py-3 px-4">sites.xml</th>
                  <th className="py-3 px-4">Registry Zone 2</th>
                  <th className="py-3 px-4 text-right">ఆడిట్ స్కోర్</th>
                </tr>
              )}
              {activeBox === 'dsc' && (
                <tr>
                  <th className="py-3 px-4">PC పేరు</th>
                  <th className="py-3 px-4">టోకెన్ కనెక్ట్ అయిందా?</th>
                  <th className="py-3 px-4">డ్రైవర్ స్థితి</th>
                  <th className="py-3 px-4">DigiSigner Bridge</th>
                  <th className="py-3 px-4 text-right">సర్టిఫికేట్</th>
                </tr>
              )}
              {activeBox === 'activity' && (
                <tr>
                  <th className="py-3 px-4">సమయం (Time)</th>
                  <th className="py-3 px-4">PC పేరు</th>
                  <th className="py-3 px-4">యాక్షన్ (Action)</th>
                  <th className="py-3 px-4">రిమార్క్స్ (Remarks)</th>
                  <th className="py-3 px-4 text-right">హెల్త్ స్కోర్</th>
                </tr>
              )}
            </thead>
            <tbody className="divide-y divide-slate-100 text-xs">
              {filteredRecords.length === 0 ? (
                <tr>
                  <td colSpan={5} className="py-12 text-center text-slate-400 italic font-medium">
                    డేటా అందుబాటులో లేదు (No matching records found).
                  </td>
                </tr>
              ) : (
                filteredRecords.map((r) => (
                  <tr key={r.pcId} className="hover:bg-slate-50/50 transition-colors">
                    {activeBox === 'inventory' && (
                      <>
                        <td className="py-4 px-4">
                          <div className="font-bold text-slate-900">{r.pcName}</div>
                          <div className="text-[0.65rem] text-slate-500 font-mono">{r.pcId}</div>
                        </td>
                        <td className="py-4 px-4">
                          <div className="font-medium text-slate-700">{r.userName}</div>
                          <div className="text-[0.65rem] text-slate-500">{r.officeLocation}</div>
                        </td>
                        <td className="py-4 px-4 text-slate-600 font-mono">{r.lastSeen}</td>
                        <td className="py-4 px-4">
                          <span className="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-bold border border-slate-200">
                            v1.0.9
                          </span>
                        </td>
                        <td className="py-4 px-4 text-right">
                          <span className={`px-2.5 py-1 rounded-full font-bold text-[0.65rem] border ${
                            r.status === 'SUCCESS' 
                              ? 'bg-emerald-50 text-emerald-700 border-emerald-200' 
                              : 'bg-rose-50 text-rose-700 border-rose-200'
                          }`}>
                            {r.status === 'SUCCESS' ? 'HEALTHY ✅' : 'ISSUE ⚠️'}
                          </span>
                        </td>
                      </>
                    )}
                    {activeBox === 'hardware' && (
                      <>
                        <td className="py-4 px-4 font-bold text-slate-900">{r.pcName}</td>
                        <td className="py-4 px-4">
                          <div className="text-slate-700 font-medium">{r.cpuInfo}</div>
                          <div className="text-[0.65rem] text-indigo-600 font-bold">{r.ramUsage}</div>
                        </td>
                        <td className="py-4 px-4 text-slate-600">{r.diskSpace}</td>
                        <td className="py-4 px-4 text-slate-600">{r.osVersion}</td>
                        <td className="py-4 px-4 text-right font-mono text-slate-500">{r.ipAddress}</td>
                      </>
                    )}
                    {activeBox === 'policies' && (
                      <>
                        <td className="py-4 px-4 font-bold text-slate-900">{r.pcName}</td>
                        <td className="py-4 px-4">
                          <span className={`px-2 py-0.5 rounded text-[0.65rem] font-bold ${
                            r.edgeIeMode === 'IE5 Quirks Active' ? 'text-emerald-600' : 'text-rose-600'
                          }`}>
                            {r.edgeIeMode}
                          </span>
                        </td>
                        <td className="py-4 px-4">
                          <span className={`px-2 py-0.5 rounded text-[0.65rem] font-bold ${
                            r.sitesXml === 'sites.xml Valid' ? 'text-emerald-600' : 'text-rose-600'
                          }`}>
                            {r.sitesXml}
                          </span>
                        </td>
                        <td className="py-4 px-4 text-emerald-600 font-bold">Applied ✅</td>
                        <td className="py-4 px-4 text-right font-black text-indigo-600">{r.healthScore}%</td>
                      </>
                    )}
                    {activeBox === 'dsc' && (
                      <>
                        <td className="py-4 px-4 font-bold text-slate-900">{r.pcName}</td>
                        <td className="py-4 px-4">
                          <span className="text-emerald-600 font-bold">Connected ✅</span>
                        </td>
                        <td className="py-4 px-4 text-slate-600">{r.dscStatus}</td>
                        <td className="py-4 px-4 text-indigo-600 font-bold">{r.nicDigiSigner}</td>
                        <td className="py-4 px-4 text-right">
                          <span className="text-emerald-600 font-bold">Valid (2028)</span>
                        </td>
                      </>
                    )}
                    {activeBox === 'activity' && (
                      <>
                        <td className="py-4 px-4 text-slate-500 font-mono">{r.time}</td>
                        <td className="py-4 px-4 font-bold text-slate-900">{r.pcName}</td>
                        <td className="py-4 px-4">
                          <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${
                            r.status === 'SUCCESS' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'
                          }`}>
                            {r.status === 'SUCCESS' ? 'TELEMETRY_SYNC' : 'ISSUE_DETECTED'}
                          </span>
                        </td>
                        <td className="py-4 px-4 text-slate-600 italic">"{r.remarks}"</td>
                        <td className="py-4 px-4 text-right font-black text-indigo-600">{r.healthScore}%</td>
                      </>
                    )}
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>

      <div className="bg-slate-50 rounded-2xl border border-slate-200 p-6 flex flex-col md:flex-row items-center justify-between gap-4">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600">
            <Info className="w-5 h-5" />
          </div>
          <div>
            <div className="text-sm font-bold text-slate-900">సహాయం కావాలా? (Need Help?)</div>
            <div className="text-xs text-slate-500">ఏదైనా PC డేటా సరిగ్గా రాకపోతే టెలిగ్రామ్ గ్రూప్‌లో సంప్రదించండి.</div>
          </div>
        </div>
        
        <div className="flex items-center gap-4">
          <a
            href="https://t.me/ubd_support"
            target="_blank"
            rel="noopener noreferrer"
            className="text-xs font-bold text-indigo-600 hover:text-indigo-800 transition-colors"
          >
            Telegram Support →
          </a>
          <button
            onClick={() => showInfo('మేనేజ్‌మెంట్ ఫీచర్లు త్వరలో రానున్నాయి...', 'Coming Soon')}
            className="px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 font-bold text-xs hover:bg-slate-50 transition-all shadow-xs"
          >
            PCలను మేనేజ్ చేయండి
          </button>
        </div>
      </div>
    </div>
  );
};