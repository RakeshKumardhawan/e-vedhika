# ====================================================================
# E-VEDHIKA /admin/ Apache Rewrite Rules
# Routes /admin/ubd_monitoring directly to /admin/ubd_monitoring.php
# ====================================================================

RewriteEngine On

# Allow direct access to real files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route /admin/ubd_monitoring to /admin/ubd_monitoring.php
RewriteRule ^ubd_monitoring/?$ ubd_monitoring.php [L,QSA]

# General fallback: append .php if file exists
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]
