# ====================================================================
# E-VEDHIKA Root Apache Rewrite Rules (.htaccess)
# ====================================================================

RewriteEngine On

# Route /admin/ubd_monitoring directly to /admin/ubd_monitoring.php
RewriteRule ^admin/ubd_monitoring/?$ admin/ubd_monitoring.php [L,QSA]
RewriteRule ^ubd_monitoring/?$ admin/ubd_monitoring.php [L,QSA]

# If the requested file or directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Automatically append .php if corresponding php file exists
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]
