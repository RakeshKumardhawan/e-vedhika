rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    
    function isSuperAdmin() {
      return isSignedIn() && 
             'email' in request.auth.token && 
             (request.auth.token.email.lower() == 'rakeshkumardhawan123@gmail.com' ||
              request.auth.token.email.lower().matches('.*admin.*'));
    }

    function isAdmin() { 
      return isSuperAdmin() || 
             (isSignedIn() && (
               exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
               (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() in [
                  'admin', 'super_admin', 'super admin', 'editor', 'moderator', 'staff', 'administrator', 'system admin'
                ])
             )); 
    }

    // -------------------------------------------------------------------------
    // SUPPORT TICKETS & CITIZEN INQUIRIES (Always open for public/citizen reports)
    // -------------------------------------------------------------------------
    match /support_tickets/{ticketId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Notifications & Logs (Open for delivery & auditing)
    match /notifications/{id} { allow read, write: if true; }
    match /admin_notifications/{id} { allow read, write: if true; }
    match /admin_inbox/{id} { allow read, write: if true; }
    match /security_logs/{id} { allow read, write: if true; }
    match /system_errors/{id} { allow read, write: if true; }
    match /systemAlerts/{id} { allow read, write: if true; }
    match /visitor_logs/{id} { allow read, write: if true; }
    match /telemetry_records/{id} { allow read, write: if true; }
    match /deploymentLogs/{id} { allow read, write: if true; }

    // Posts & Problems & Suggestions
    match /posts/{postId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
    match /problems/{problemId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
    match /suggestions/{suggestionId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // System Configs
    match /site_settings/{id} { allow read, write: if true; }
    match /settings/{id} { allow read, write: if true; }
    match /customMenus/{id} { allow read, write: if true; }
    match /customMenuCards/{id} { allow read, write: if true; }
    match /home_sections/{id} { allow read, write: if true; }
    match /typing_status/{id} { allow read, write: if true; }

    // Fallback Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

