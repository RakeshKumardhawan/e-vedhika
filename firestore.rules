rules_version = '2';

service cloud.firestore {
match /databases/{database}/documents {

match /posts/{postId} {
  allow read: if true;
  
  // ఎవరైనా పోస్ట్‌ను లైక్ చేయడానికి, కామెంట్లు పెంచడానికి, వ్యూస్ పెంచడానికి లేదా షేర్ సోర్సెస్ అప్‌డేట్ చేయడానికి (లాగిన్‌తో సంబంధం లేకుండా):
  allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'views', 'viewedBy', 'commentCount', 'likes', 'likedBy', 
                    'source_whatsapp', 'source_facebook', 'source_twitter', 'source_direct', 'source_other'
                  ]);

  // అడ్మిన్ లేదా పోస్ట్ ఓనర్ కి అన్ని అప్డేట్ పర్మిషన్స్:
  allow update: if isAdmin() || (isSignedIn() && isExistingOwner('uid'));
  
  allow create: if isSignedIn() && (isOwner('uid') || isOwner('authorId'));
  allow delete: if isAdmin() || (isSignedIn() && isExistingOwner('uid'));
  
  match /comments/{commentId} {
    allow read: if true;
    allow create: if true; // ఎవరైనా కామెంట్ చేయవచ్చు (లాగిన్‌తో సంబంధం లేకుండా)
    allow update: if isAdmin() || (isSignedIn() && isExistingOwner('uid')) || 
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'replies']); // ఎవరైనా లైక్ లేదా రిప్లై ఇవ్వవచ్చు
    allow delete: if isAdmin() || (isSignedIn() && isExistingOwner('uid'));
  }
}

// -------------------------------------------------------------------------
// HELPERS (సహాయక ఫంక్షన్లు)
// -------------------------------------------------------------------------
function isSignedIn() { return request.auth != null; }
function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }

// 1. SUPER ADMIN: కేవలం ఈ ఈమెయిల్ కి మాత్రమే పూర్తి అధికారాలు (బాస్/వెబ్ డెవలపర్)
function isSuperAdmin() {
  return isSignedIn() && 
         'email' in request.auth.token && 
         (request.auth.token.email == 'rakeshkumardhawan123@gmail.com' || request.auth.token.email == 'Rakeshkumardhawan123@gmail.com');
}

// 2. ADMIN/MODERATOR: సూపర్ అడ్మిన్ లేదా భవిష్యత్తులో అడ్మిన్ ప్యానెల్ ద్వారా యాడ్ చేయబడిన వారు
// బ్రేకప్ సర్క్యులర్ డిపెండెన్సీ: exists() కాలింగ్ isAdmin() ని నివారించాలి
function isAdmin() { 
  return isSuperAdmin() || 
         (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))); 
}

// గ్లోబల్ సూపర్ అడ్మిన్ పర్మిషన్: ఏ ఎర్రర్ రాకుండా ఉండటానికి

function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
function incoming() { return request.resource.data; }
function existing() { return resource == null ? {} : resource.data; }
function isOwner(field) { return field in incoming() && incoming()[field] == request.auth.uid; }
function isExistingOwner(field) { return resource != null && field in resource.data && resource.data[field] == request.auth.uid; }

// -------------------------------------------------------------------------
// COLLECTIONS
// -------------------------------------------------------------------------

// PIN కలెక్షన్
match /user_pins/{pinId} {
  allow read, write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == pinId);
}

match /pins/{pinId} {
  allow read: if isSignedIn();
  allow write: if isSuperAdmin();
}


// ADMINS కలెక్షన్: కొత్త ఎడిటర్స్ ని యాడ్ చేసే పవర్ కేవలం "Super Admin" కి మాత్రమే
match /admins/{adminId} {
  allow read: if isValidId(adminId) && (isSuperAdmin() || (isSignedIn() && request.auth.uid == adminId));
  allow write: if isSuperAdmin(); 
}

match /updates/{updateId} {
  allow read: if true;
  allow write: if isAdmin(); // పబ్లిక్ యాక్సెస్ తీసేసి అడ్మిన్ కి మాత్రమే ఇచ్చాం
}

match /suggestions/{suggestionId} {
  allow read: if true;
  allow create: if true; 
  allow update, delete: if isAdmin() || (isSignedIn() && isExistingOwner('uid') && (!('status' in incoming()) || incoming().status == (resource == null ? null : resource.data.status)));
}

match /users/{userId} {
  allow read: if isSignedIn(); 
  allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
  allow delete: if isSuperAdmin(); // అకౌంట్స్ డిలీట్ చేసే పవర్ కేవలం సూపర్ అడ్మిన్ కి మాత్రమే
}

match /chat/{msgId} {
  allow read: if true;
  allow create: if isSignedIn() && isOwner('uid');
  allow update, delete: if isAdmin() || (isSignedIn() && isExistingOwner('uid'));
}

match /problems/{problemId} {
  allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
  allow create: if isSignedIn() && (isOwner('uid') || isOwner('userId') || isOwner('authorId') || !('uid' in incoming())); 
  allow update, delete: if isAdmin() || (isSignedIn() && isExistingOwner('uid') && (!('status' in incoming()) || incoming().status == (resource == null ? null : resource.data.status)));
}

match /requests/{requestId} {
  allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
  allow create: if isSignedIn() && isOwner('uid');
  allow update, delete: if isAdmin() || (isSignedIn() && isExistingOwner('uid'));
}

match /gos_formats/{docId} {
  allow read: if true;
  allow create: if isSignedIn() && isOwner('uploadedBy');
  allow update, delete: if isAdmin() || (isSignedIn() && isExistingOwner('uploadedBy'));
}

match /forms/{formId} {
  allow read: if true;
  allow create: if isSignedIn();
  allow update, delete: if isAdmin() || (isSignedIn() && isExistingOwner('uid'));
}

match /notifications/{notifId} {
  allow read: if true; // ఎవరైనా నోటిఫికేషన్లు చదవవచ్చు
  allow create: if true; // ఎవరైనా నోటిఫికేషన్లు క్రియేట్ చేయవచ్చు
  allow update: if true; // ఎవరైనా అప్‌డేట్ చేయవచ్చు (readBy, read మొదలైనవి)
  allow delete: if isAdmin() || (isSignedIn() && isExistingOwner('uid'));
}

match /usernames/{username} {
  allow read: if true;
  allow write: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
}

match /settings/{settingId} {
  allow read: if settingId != 'admin_config' || isSuperAdmin();
  allow update: if settingId == 'site_stats' || isAdmin();
  allow create, delete: if isSuperAdmin();
}

// యాప్ ఎర్రర్స్ చూడటం, డిలీట్ చేయడం కేవలం సూపర్ అడ్మిన్ మాత్రమే
match /app_errors/{docId} {
  allow create: if true;
  allow read, update, delete: if isSuperAdmin(); 
}

// సెక్యూరిటీ లాగ్స్ అందరికి
match /security_logs/{logId} {
  allow read: if true; 
  allow create: if true;
  allow update, delete: if isSuperAdmin();
}

match /polls/{pollId} {
  allow read: if true;
  allow create, update: if isAdmin() || isSignedIn();
  allow delete: if isAdmin();
}

match /home_sections/{sectionId} {
  allow read: if true;
  allow write: if isAdmin();
}

match /deploymentLogs/{logId} {
  allow read: if true;
  allow create: if true;
}

// Default deny (fallback) - పైన పేర్కొనని కలెక్షన్స్ ఏవైనా ఉంటే వాటిని బ్లాక్ చేస్తుంది
match /{document=**} {
  allow read, write: if false;
}

}
}
